{
  "name": "gitea-vs-extension",
  "displayName": "Gitea VS Extension",
  "description": "Gitea Actions status and logs in VS Code/Cursor.",
  "icon": "media/icon.png",
  "version": "0.4.1",
  "publisher": "bircni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bircni/gitea-vs-extension"
  },
  "homepage": "https://github.com/bircni/gitea-vs-extension",
  "bugs": {
    "url": "https://github.com/bircni/gitea-vs-extension/issues"
  },
  "keywords": [
    "gitea",
    "actions",
    "workflows",
    "logs"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "extensionRecommendations": [
    "bircni.compress-preview"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "audit": "npm audit --audit-level high",
    "build": "npm run compile && npm run bundle && npm run package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --sourcemap",
    "check-unused": "depcheck .",
    "clean": "rimraf dist",
    "compile": "tsc --project tsconfig.build.json",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "install:debug": "npm run build && code --install-extension dist/extension.vsix --force",
    "uninstall:debug": "code --uninstall-extension bircni.gitea-vs-extension",
    "lint": "oxlint --type-aware .",
    "package": "vsce package --out dist/extension.vsix",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/test/gitea-api-mock.integration.test.ts",
    "test:live": "node scripts/gitea-live-smoke.cjs",
    "compile:e2e": "tsc --project tsconfig.e2e.json",
    "test:e2e": "npm run compile && npm run bundle && npm run compile:e2e && node out/test/e2e/runTest.js",
    "test:e2e:gitea": "npm run compile && npm run bundle && npm run compile:e2e && node out/test/e2e/runGiteaFixtureTest.js",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --coverage --coverage.reporter=html && echo 'HTML report generated at: .tmp/coverage/index.html'",
    "test:watch": "vitest",
    "validate": "npm run check-unused && npm run lint && npm run format && npm run test && npm run build",
    "update:swagger": "node scripts/update-swagger-from-gitea.js",
    "watch": "tsc  --project tsconfig.build.json --watch",
    "release": "node scripts/release.js"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Gitea VS Extension",
      "properties": {
        "gitea-vs-extension.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for the Gitea instance, e.g. http://localhost:3000."
        },
        "gitea-vs-extension.tls.insecureSkipVerify": {
          "type": "boolean",
          "default": false,
          "description": "Disable TLS certificate verification for HTTPS connections."
        },
        "gitea-vs-extension.discovery.mode": {
          "type": "string",
          "enum": [
            "workspace",
            "allAccessible"
          ],
          "default": "workspace",
          "description": "Repository discovery mode."
        },
        "gitea-vs-extension.refresh.runningIntervalSeconds": {
          "type": "number",
          "default": 15,
          "description": "Refresh interval when runs are queued or running."
        },
        "gitea-vs-extension.refresh.idleIntervalSeconds": {
          "type": "number",
          "default": 60,
          "description": "Refresh interval when idle."
        },
        "gitea-vs-extension.maxRunsPerRepo": {
          "type": "number",
          "default": 20,
          "description": "Maximum workflow runs to load per repository."
        },
        "gitea-vs-extension.maxJobsPerRun": {
          "type": "number",
          "default": 50,
          "description": "Maximum workflow jobs to load per run."
        },
        "gitea-vs-extension.logging.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the extension output channel."
        },
        "gitea-vs-extension.reviewComments.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Gitea pull request review comments inline in the editor for the current branch."
        },
        "gitea-vs-extension.jobLogs.saveToRepo": {
          "type": "boolean",
          "default": true,
          "description": "When opening job logs locally, save the log file to the repo at .tmp/gitea-logs/<run>-<job>.log so it opens as a saved file. When disabled, logs open in an unsaved editor tab."
        },
        "gitea-vs-extension.artifacts.downloadPath": {
          "type": "string",
          "default": ".tmp/gitea-artifacts/",
          "description": "Base directory for downloaded workflow artifacts. Relative to the first workspace folder, or use an absolute path. Requires Gitea token with Actions scope (read workflow runs and artifacts)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bircniGiteaVsExtension",
          "title": "Gitea VS Extension",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "bircniGiteaVsExtension": [
        {
          "type": "tree",
          "id": "gitea-vs-extension.runs",
          "name": "Current Branch Runs"
        },
        {
          "type": "tree",
          "id": "gitea-vs-extension.pullRequests",
          "name": "Pull Requests"
        },
        {
          "type": "tree",
          "id": "gitea-vs-extension.runsPinned",
          "name": "Workflows"
        },
        {
          "type": "tree",
          "id": "gitea-vs-extension.settings",
          "name": "Settings",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "gitea-vs-extension.setToken",
        "title": "gitea-vs-extension: Set Token",
        "icon": "$(pencil)"
      },
      {
        "command": "gitea-vs-extension.clearToken",
        "title": "gitea-vs-extension: Clear Token",
        "icon": "$(trash)"
      },
      {
        "command": "gitea-vs-extension.testConnection",
        "title": "gitea-vs-extension: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "gitea-vs-extension.refresh",
        "title": "gitea-vs-extension: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitea-vs-extension.refreshRepo",
        "title": "gitea-vs-extension: Refresh Repository",
        "icon": "$(refresh)"
      },
      {
        "command": "gitea-vs-extension.viewJobLogs",
        "title": "gitea-vs-extension: View Job Logs",
        "icon": "$(list-unordered)"
      },
      {
        "command": "gitea-vs-extension.openLatestFailedJobLogs",
        "title": "gitea-vs-extension: Open Latest Failed Job Logs",
        "icon": "$(error)"
      },
      {
        "command": "gitea-vs-extension.openInBrowser",
        "title": "gitea-vs-extension: Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "gitea-vs-extension.copyUrl",
        "title": "gitea-vs-extension: Copy URL",
        "icon": "$(copy)"
      },
      {
        "command": "gitea-vs-extension.refreshSecrets",
        "title": "gitea-vs-extension: Refresh Secrets",
        "icon": "$(refresh)"
      },
      {
        "command": "gitea-vs-extension.refreshVariables",
        "title": "gitea-vs-extension: Refresh Variables",
        "icon": "$(refresh)"
      },
      {
        "command": "gitea-vs-extension.createSecret",
        "title": "gitea-vs-extension: Add Secret",
        "icon": "$(add)"
      },
      {
        "command": "gitea-vs-extension.updateSecret",
        "title": "gitea-vs-extension: Update Secret",
        "icon": "$(pencil)"
      },
      {
        "command": "gitea-vs-extension.deleteSecret",
        "title": "gitea-vs-extension: Delete Secret",
        "icon": "$(trash)"
      },
      {
        "command": "gitea-vs-extension.createVariable",
        "title": "gitea-vs-extension: Add Variable",
        "icon": "$(add)"
      },
      {
        "command": "gitea-vs-extension.updateVariable",
        "title": "gitea-vs-extension: Update Variable",
        "icon": "$(pencil)"
      },
      {
        "command": "gitea-vs-extension.deleteVariable",
        "title": "gitea-vs-extension: Delete Variable",
        "icon": "$(trash)"
      },
      {
        "command": "gitea-vs-extension.openBaseUrlSettings",
        "title": "gitea-vs-extension: Open Base URL Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitea-vs-extension.switchBranchFilter",
        "title": "gitea-vs-extension: Change Branch Filter",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitea-vs-extension.downloadArtifact",
        "title": "Download",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitea-vs-extension.addReviewComment",
        "title": "gitea-vs-extension: Add Review Comment",
        "icon": "$(comment-add)"
      },
      {
        "command": "gitea-vs-extension.revealArtifactInExplorer",
        "title": "Reveal in File Explorer",
        "icon": "$(file-directory)"
      },
      {
        "command": "gitea-vs-extension.openOrRevealArtifact",
        "title": "Open"
      },
      {
        "command": "gitea-vs-extension.checkoutPrBranch",
        "title": "gitea-vs-extension: Checkout PR Branch",
        "icon": "$(source-control)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitea-vs-extension.refresh",
          "when": "view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned || view == gitea-vs-extension.pullRequests",
          "group": "navigation"
        },
        {
          "command": "gitea-vs-extension.switchBranchFilter",
          "when": "view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitea-vs-extension.refresh",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned || view == gitea-vs-extension.pullRequests) && viewItem == giteaRepo",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.refreshRepo",
          "when": "viewItem == giteaRepo",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.switchBranchFilter",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && viewItem == giteaRepo",
          "group": "inline@2"
        },
        {
          "command": "gitea-vs-extension.openInBrowser",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && viewItem == giteaRun",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.openLatestFailedJobLogs",
          "when": "viewItem == giteaRun",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.openInBrowser",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && viewItem == giteaJob",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.viewJobLogs",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && (viewItem == giteaJob || viewItem == giteaStep)",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.openInBrowser",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned || view == gitea-vs-extension.pullRequests) && viewItem == giteaPullRequest",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.checkoutPrBranch",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned || view == gitea-vs-extension.pullRequests) && viewItem == giteaPullRequest",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.copyUrl",
          "when": "viewItem == giteaRepo || viewItem == giteaRun || viewItem == giteaJob || viewItem == giteaStep || viewItem == giteaPullRequest",
          "group": "inline@2"
        },
        {
          "command": "gitea-vs-extension.openInBrowser",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && viewItem == giteaArtifact",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.downloadArtifact",
          "when": "(view == gitea-vs-extension.runs || view == gitea-vs-extension.runsPinned) && viewItem == giteaArtifact",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.refreshSecrets",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaSecretsRoot",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.createSecret",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaSecretsRoot",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.updateSecret",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaSecret",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.deleteSecret",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaSecret",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.refreshVariables",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaVariablesRoot",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.createVariable",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaVariablesRoot",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.updateVariable",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaVariable",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.deleteVariable",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaVariable",
          "group": "inline@1"
        },
        {
          "command": "gitea-vs-extension.setToken",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaToken",
          "group": "inline"
        },
        {
          "command": "gitea-vs-extension.clearToken",
          "when": "view == gitea-vs-extension.settings && viewItem == giteaToken",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "gitea-vs-extension.addReviewComment",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "overrides": {
    "yauzl": ">=3.2.1",
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "24.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "depcheck": "1.4.7",
    "esbuild": "0.28.1",
    "glob": "13.0.6",
    "mocha": "11.7.6",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "undici": "8.9.0"
  }
}
