{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".cursor/**",
    ".specify/**",
    ".vscode/**",
    "cliff.toml",
    "docs/**",
    "src/test/mock-gitea/fixtures/**"
  ]
}
